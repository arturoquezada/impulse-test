function buildReqView(req,sectionNum,title,questions){
  const data=req[`s${sectionNum}`]||{};
  const filled=questions.some((_,i)=>data[`q${i}`]);
  return `
    <div class="req-block">
      <div class="req-block-title">${sectionNum}. ${esc(title)} ${filled?"":"<span style='color:#ef4444;font-size:10px;'>⚠ Incomplete</span>"}</div>
      ${questions.map((q,i)=>`
        <div style="margin-bottom:8px;">
          <div style="font-size:11px;color:var(--ink-3);font-weight:700;margin-bottom:3px;">${esc(q)}</div>
          <div style="font-size:13px;color:var(--ink);line-height:1.4;min-height:20px;">${data[`q${i}`]?esc(data[`q${i}`]):`<span style="color:var(--ink-4);font-style:italic;">Not filled yet</span>`}</div>
        </div>`).join("")}
    </div>`;
}

