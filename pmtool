/* ═══════════════════════════════════
   HELPERS
═══════════════════════════════════ */
function esc(v){ return String(v??"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;"); }
function fmtNum(n,d=0){ const x=Number(n||0); return Number.isFinite(x)?x.toFixed(d):"0"; }
function isPast(d){ if(!d) return false; const t=new Date(); t.setHours(0,0,0,0); return new Date(d+"T00:00:00")<t; }

function projStatusClass(s){
  const m={"Requested":"requested","Under Review":"underreview","Draft":"draft","In Progress":"inprogress","On Hold":"onhold","Completed":"completed","Cancelled":"cancelled"};
  return m[s]||"draft";
}

function badgeStatus(s){
  const m={"Requested":"b-requested","Under Review":"b-underreview","Draft":"b-draft","In Progress":"b-inprogress","On Hold":"b-onhold","Completed":"b-completed","Cancelled":"b-cancelled","Suggested":"b-suggested","To Do":"b-todo","Done":"b-done","Blocked":"b-blocked","Paused":"b-paused"};
  return `<span class="badge ${m[s]||"b-draft"}">${esc(s)}</span>`;
}

function badgePriority(p){
  const m={"Low":"b-low","Medium":"b-medium","High":"b-high"};
  return `<span class="badge ${m[p]||"b-medium"}">${esc(p)}</span>`;
}

function badgeCompliance(l){
  const m={"Open":"b-c-open","Before deadline":"b-c-before","On deadline":"b-c-on","After deadline":"b-c-after","Overdue":"b-c-overdue"};
  return `<span class="badge ${m[l]||"b-c-open"}">${esc(l)}</span>`;
}

function projCompliance(p){
  if(!p?.completed_at||!p?.due_date) return "Open";
  const c=new Date(p.completed_at), d=new Date(p.due_date+"T23:59:59");
  if(c<d) return "Before deadline";
  if(c.toDateString()===d.toDateString()) return "On deadline";
  return "After deadline";
}

function taskCompliance(t){
  if(!t?.completed_at||!t?.due_date){
    if(t?.status!=="Done"&&t?.status!=="Suggested"&&isPast(t?.due_date)) return "Overdue";
    return "Open";
  }
  const c=new Date(t.completed_at), d=new Date(t.due_date+"T23:59:59");
  if(c<d) return "Before deadline";
  if(c.toDateString()===d.toDateString()) return "On deadline";
  return "After deadline";
}

function computeProgress(tasks){
  const clean=(tasks||[]).filter(t=>!t.is_deleted&&t.status!=="Suggested");
  if(!clean.length) return {done:0,total:0,pct:0};
  const tw=clean.reduce((s,t)=>s+Number(t.weight_percent||0),0);
  if(!tw){ const d=clean.filter(t=>t.status==="Done").length; return {done:d,total:clean.length,pct:clean.length?(d/clean.length)*100:0}; }
  const dw=clean.filter(t=>t.status==="Done").reduce((s,t)=>s+Number(t.weight_percent||0),0);
  return {done:dw,total:tw,pct:tw?(dw/tw)*100:0};
}

function dotColor(s){ const m={"To Do":"#94a3b8","In Progress":"#3b82f6","Blocked":"#ef4444","Paused":"#f59e0b","Done":"#10b981","Cancelled":"#64748b","Suggested":"#7c3aed"}; return m[s]||"#94a3b8"; }

