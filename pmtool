   ADD LINK MODAL
═══════════════════════════════════ */
function openAddLinkModal(projectId,closeParent){
  if(!isPM) return;
  const body=`<div class="panel"><div class="form-grid form-grid-1">
    <div class="fg2"><label>Title *</label><input id="alTitle" class="fi2" placeholder="Main doc, spec, etc."></div>
    <div class="fg2"><label>URL *</label><input id="alUrl" class="fi2" placeholder="https://…"></div>
  </div></div>`;
  const footer=`<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="alSubmit">Add Link</button>`;
  const {el,close}=openModal(mShell("Add Project Link","",body,footer),"modal-sm");
  el.querySelector("#alSubmit").addEventListener("click",async()=>{
    const title=document.getElementById("alTitle")?.value?.trim();
    const url=document.getElementById("alUrl")?.value?.trim();
    if(!title||!url){ alert("Please fill both fields."); return; }
    const {error}=await supabase.from("pm_project_links").insert({project_id:projectId,title,url,link_type:"other",added_by_user_id:currentUser.id});
    if(error){ alert(error.message); return; }
    close(); closeParent?.();
    await openProjectDetail(projectId);
  });
}
window.openAddLinkModal=openAddLinkModal;
</script>
</body>
