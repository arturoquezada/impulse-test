async function createProject(btn,closeModal){
  const name    =document.getElementById("cpName")?.value?.trim();
  const area    =document.getElementById("cpType")?.value;
  const priority=document.getElementById("cpPriority")?.value||"Medium";
  const ownerId =document.getElementById("cpOwner")?.value;
  const start   =document.getElementById("cpStart")?.value;
  const due     =document.getElementById("cpDue")?.value;
  const objective=document.getElementById("cpObjective")?.value?.trim()||null;
  const collabs =getChecked("cp_collabs");

  if(!name||!area||!start||!due||!ownerId){ alert("Please fill Name, Type, Owner, Start Date and Due Date."); return; }
  if(new Date(due)<new Date(start)){ alert("Due date cannot be before start date."); return; }

  btn.disabled=true; btn.textContent="Submitting…";

  const {data:proj,error}=await supabase.from("pm_projects").insert({
    name,area,priority,status:"Requested",
    owner_user_id:ownerId,created_by_user_id:currentUser.id,
    start_date:start,due_date:due,objective,
    submitted_at:new Date().toISOString(),review_count:0
  }).select("*").single();

  if(error||!proj){ alert(error?.message||"Error"); btn.disabled=false; btn.textContent="Submit Request"; return; }

  // Members
  const mRows=[{project_id:proj.id,user_id:ownerId,member_role_in_project:"owner"}];
