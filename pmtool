      <div><div class="banner-text">✅ Project Completed</div>
      <div class="banner-sub">Completed on ${esc(project.completed_at?.split("T")[0]||"—")} · ${badgeCompliance(compliance)}</div></div>
    </div>`;
  }

  if(project.status==="Cancelled"&&project.cancelled_until){
    bannerHtml+=`<div class="banner banner-red">
      <div><div class="banner-text">🚫 Cancelled</div>
      <div class="banner-sub">This project was rejected ${MAX_REVIEWS} times and is frozen until ${esc(project.cancelled_until)}.</div></div>
    </div>`;
  }

  if(rc>0&&rc<MAX_REVIEWS&&["Requested","Draft"].includes(project.status)){
    bannerHtml+=`<div style="background:var(--red-bg);border:1px solid #fecaca;border-radius:10px;padding:12px 16px;margin-bottom:14px;font-size:13px;color:var(--red);font-weight:700;">
      ⚠️ This project has been rejected ${rc} time(s). ${MAX_REVIEWS-rc} attempt(s) remaining.
      ${project.rejection_notes?`<div style="margin-top:6px;font-weight:400;color:#7f1d1d;">${esc(project.rejection_notes)}</div>`:""}
    </div>`;
  }

  /* ── MEMBER CHIPS ── */
  const memberChips=members.map(m=>`<span class="chip">${esc(um[m.user_id]?.full_name||"Unknown")} · ${esc(m.member_role_in_project||"member")}</span>`).join("")||`<span class="chip">No members</span>`;

  /* ── LINKS ── */
  const linksHtml=links.length?links.map(l=>`
    <div class="row">
      <div class="row-left"><div class="row-main">${esc(l.title||"Untitled")}</div><div class="row-sub" style="word-break:break-all">${esc(l.url||"")}</div></div>
      <a href="${esc(l.url||"#")}" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">Open ↗</a>
    </div>`).join(""):`<div class="empty" style="padding:12px">No links yet.</div>`;

  /* ── SUGGESTED TASKS ── */
  const suggestedHtml=suggested.length?`
    <div class="suggested-section">
      <div class="panel-title" style="color:var(--purple);">🟣 Suggested Assignments <span class="badge b-suggested">${suggested.length}</span></div>
      ${suggested.map(t=>{
        const tOwner=um[t.owner_user_id]?.full_name||"Unassigned";
        return `<div class="sug-item" data-sug-id="${esc(t.id)}">
          <div class="sug-item-name">${esc(t.name||"Untitled task")}</div>
          <div class="sug-item-meta">
            <span><strong>Owner:</strong> ${esc(tOwner)}</span>
            <span><strong>Due:</strong> ${esc(t.due_date||"—")} · <strong>Hours:</strong> ${fmtNum(t.allocated_hours,1)}h · <strong>Weight:</strong> ${fmtNum(t.weight_percent,2)}%</span>
          </div>
          ${isPM?`<div class="sug-actions">
            <button class="btn btn-success btn-sm" data-approve-task="${esc(t.id)}">✓ Approve</button>
            <button class="btn btn-danger btn-sm" data-decline-task="${esc(t.id)}">✕ Decline</button>
          </div>`:`<span class="badge b-suggested">Pending PM approval</span>`}
        </div>`;
      }).join("")}
    </div>`:"";

  /* ── REQUIREMENTS TEMPLATE ── */
  const canEditReq=isOwnerOrPM;
  const reqHtml=`
    <div class="req-section">
      <div class="req-section-title">📋 Requirements Template
        ${canEditReq?`<button class="btn btn-sm" style="background:#fff;color:#92400e;border:1px solid #fde68a;" id="btnEditReq">✏️ Edit</button>`:""}
      </div>

      ${buildReqView(req,1,"Información General del Proyecto",["¿Nombre del proyecto?","¿Área solicitante?","¿Solicitante (nombre y rol)?"])}
      ${buildReqView(req,2,"Objetivo del Proyecto",["¿Qué se busca lograr?","¿Por qué es importante?","¿Qué problema resuelve?"])}
      ${buildReqView(req,3,"Alcance",["¿Qué incluye?","¿Qué no incluye?","¿Qué esperas recibir?","¿Qué sería una mala experiencia?","Si recortáramos tiempo, ¿qué es indispensable?"])}
      ${buildReqView(req,4,"Requerimientos",["Req 1 — ¿Qué problema tienes?","Req 1 — ¿Qué impacto tiene?","Req 2 — Cambios de estructura (si aplica)","Req 3 — Requerimientos técnicos"])}
      ${buildReqView(req,5,"Stakeholders y Usuarios",["Stakeholders clave","Usuarios finales","Áreas involucradas"])}
      ${buildReqView(req,6,"Tiempos y Fechas Clave",["Fecha ideal de inicio","Fecha objetivo de entrega","Fechas críticas / hitos","¿Quién necesita visibilidad del avance?"])}
      ${buildReqView(req,7,"Prioridad del Proyecto",["Tipo de prioridad (P0/P1/P2/P3)","¿Por qué se considera urgente?"])}
      ${buildReqView(req,8,"Riesgos y Dependencias",["Riesgos identificados","Dependencias","¿Qué podría retrasar el proyecto?","¿Dependemos de aprobaciones externas?"])}
      ${buildReqView(req,9,"Bloqueos",["¿Qué asumimos para avanzar?","¿Se necesita presupuesto aprobado?","¿Se cuenta con accesos o herramientas?"])}
      ${buildReqView(req,10,"Métricas de Éxito (KPIs)",["KPI 1","KPI 2","KPI 3","¿Qué indicadores deben mejorar?"])}
      ${buildReqView(req,11,"Recursos Requeridos",["Personas necesarias","Herramientas requeridas","Presupuesto (si aplica)"])}
    </div>`;

  /* ── KANBAN ── */
  const kanbanStatuses=["To Do","In Progress","Blocked","Paused","Done","Cancelled"];
  const kanbanHtml=kanbanStatuses.map(s=>renderKanbanCol(s,regular,um)).join("");

  /* ── BUILD BODY ── */
  const body=`
    ${bannerHtml}

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
      <div class="panel" style="margin-bottom:0">
        <div class="panel-title">Project Info</div>
        <div class="kv-grid">
          <div class="kv"><span class="kv-l">Owner</span><span class="kv-v">${esc(ownerName)}</span></div>
          <div class="kv"><span class="kv-l">Status</span>${badgeStatus(project.status)}</div>
          <div class="kv"><span class="kv-l">Type</span><span class="kv-v">${esc(project.area||"—")}</span></div>
          <div class="kv"><span class="kv-l">Priority</span>${badgePriority(project.priority||"Medium")}</div>
          <div class="kv"><span class="kv-l">Start</span><span class="kv-v">${esc(project.start_date||"—")}</span></div>
          <div class="kv"><span class="kv-l">Due</span>
            <span class="kv-v" style="display:flex;align-items:center;gap:8px;">
              ${esc(project.due_date||"—")}
              ${isPM&&project.status!=="Completed"?`<button class="btn btn-ghost btn-sm" id="btnEditDue" style="padding:3px 8px;font-size:11px;">✏️</button>`:""}
            </span>
          </div>
          ${rc>0?`<div class="kv"><span class="kv-l">Review attempts</span><span class="kv-v" style="color:var(--red)">${rc} / ${MAX_REVIEWS}</span></div>`:""}
        </div>
        ${project.objective?`<div style="margin-top:12px;"><div style="font-size:11px;font-weight:800;text-transform:uppercase;color:var(--ink-3);margin-bottom:5px;">Objective</div><div style="font-size:13px;color:var(--ink-2);line-height:1.5">${esc(project.objective)}</div></div>`:""}
        <div style="margin-top:12px;"><div style="font-size:11px;font-weight:800;text-transform:uppercase;color:var(--ink-3);margin-bottom:6px;">Members</div><div class="chips">${memberChips}</div></div>
      </div>

      <div class="panel" style="margin-bottom:0">
        <div class="panel-title">Progress</div>
        <div class="progress-bg" style="height:10px;"><div class="progress-fill" style="width:${fmtNum(weighted.pct,1)}%"></div></div>
        <div style="font-size:24px;font-weight:900;margin:8px 0;">${fmtNum(weighted.pct,1)}%</div>
        <div class="kv-grid">
          <div class="kv"><span class="kv-l">Tasks</span><span class="kv-v">${regular.length}</span></div>
          <div class="kv"><span class="kv-l">Done</span><span class="kv-v">${regular.filter(t=>t.status==="Done").length}</span></div>
          ${suggested.length?`<div class="kv"><span class="kv-l">Pending approval</span><span class="kv-v" style="color:var(--purple)">${suggested.length}</span></div>`:""}
          <div class="kv"><span class="kv-l">Compliance</span>${badgeCompliance(compliance)}</div>
        </div>
      </div>
    </div>

    ${reqHtml}

    ${suggestedHtml}

    <div class="panel">
      <div class="panel-title">Project Links
        ${isPM?`<button class="btn btn-ghost btn-sm" id="btnAddLink">+ Add Link</button>`:""}
      </div>
      ${linksHtml}
    </div>

    <div class="panel">
      <div class="panel-title">Tasks · Kanban
        <button class="btn btn-primary btn-sm" id="btnAddTask">+ ${isPM?"Add Task":"Suggest Assignment"}</button>
      </div>
      <div class="kanban-wrap" style="margin-top:10px;">${kanbanHtml}</div>
    </div>
  `;

  const footer=`<button class="btn btn-ghost" data-close>Close</button>`;
  const {el,close}=openModal(mShell(project.name||"Project",`${project.area||"—"} · ${project.status}`,body,footer));

  /* ── WIRE BUTTONS ── */

  // Start review (PM moves Requested → Under Review)
  el.querySelector("#btnStartReview")?.addEventListener("click",async()=>{
    await supabase.from("pm_projects").update({status:"Under Review"}).eq("id",project.id);
    close(); await renderPage(); await openProjectDetail(project.id);
  });

  // Approve project
  el.querySelector("#btnApprove")?.addEventListener("click",async()=>{
    if(!isPM) return;
    if(!confirm(`Approve "${project.name}"?`)) return;
    await supabase.from("pm_projects").update({status:"Draft",approved_at:new Date().toISOString()}).eq("id",project.id);
    close(); await renderPage(); await openProjectDetail(project.id);
  });

  // Reject project
  el.querySelector("#btnReject")?.addEventListener("click",async()=>{
    if(!isPM) return;
    const note=prompt("Rejection reason (required):");
    if(!note?.trim()) return;
    const newRc=rc+1;
    if(newRc>=MAX_REVIEWS){
      // Cancel for 30 days
      const cancelUntil=new Date(); cancelUntil.setDate(cancelUntil.getDate()+30);
      await supabase.from("pm_projects").update({
        status:"Cancelled",review_count:newRc,rejection_notes:note.trim(),
        cancelled_until:cancelUntil.toISOString().split("T")[0]
      }).eq("id",project.id);
      alert(`This project has been rejected ${MAX_REVIEWS} times and is now cancelled for 30 days.`);
    } else {
      await supabase.from("pm_projects").update({
        status:"Requested",review_count:newRc,rejection_notes:note.trim()
      }).eq("id",project.id);
    }
    close(); await renderPage(); await openProjectDetail(project.id);
  });

  // Mark complete
  el.querySelector("#btnComplete")?.addEventListener("click",async()=>{
    if(!isPM) return;
    if(!confirm(`Mark "${project.name}" as Completed?`)) return;
    await supabase.from("pm_projects").update({status:"Completed",completed_at:new Date().toISOString()}).eq("id",project.id);
    close(); await renderPage(); await openProjectDetail(project.id);
  });

  // Edit due date (PM only)
  el.querySelector("#btnEditDue")?.addEventListener("click",async()=>{
    const newDue=prompt("New due date (YYYY-MM-DD):",project.due_date||"");
    if(!newDue?.match(/^\d{4}-\d{2}-\d{2}$/)) return;
    await supabase.from("pm_projects").update({due_date:newDue}).eq("id",project.id);
    close(); await openProjectDetail(project.id);
  });

  // Edit requirements
  el.querySelector("#btnEditReq")?.addEventListener("click",()=>openEditReqModal(project,close));

  // Add link
  el.querySelector("#btnAddLink")?.addEventListener("click",()=>openAddLinkModal(project.id,close));

  // Add task
  el.querySelector("#btnAddTask")?.addEventListener("click",()=>openAddTaskModal(project.id,close));

  // Approve / Decline suggested tasks
  el.querySelectorAll("[data-approve-task]").forEach(btn=>{
    btn.addEventListener("click",async()=>{
      if(!isPM) return;
      await supabase.from("pm_tasks").update({status:"To Do"}).eq("id",btn.getAttribute("data-approve-task"));
      // Check if all suggested tasks approved → move to In Progress
      const {data:remaining}=await supabase.from("pm_tasks").select("id").eq("project_id",project.id).eq("status","Suggested").eq("is_deleted",false);
      if(!remaining?.length && project.status==="Draft"){
        await supabase.from("pm_projects").update({status:"In Progress"}).eq("id",project.id);
      }
      close(); await renderPage(); await openProjectDetail(project.id);
    });
  });

  el.querySelectorAll("[data-decline-task]").forEach(btn=>{
    btn.addEventListener("click",async()=>{
      if(!isPM) return;
      if(!confirm("Decline this suggested task?")) return;
      await supabase.from("pm_tasks").update({status:"Cancelled"}).eq("id",btn.getAttribute("data-decline-task"));
      close(); await renderPage(); await openProjectDetail(project.id);
    });
  });
}
window.openProjectDetail=openProjectDetail;

