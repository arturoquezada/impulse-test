async function openAddTaskModal(projectId,closeParent){
  const users=await fetchUsers();
  const body=`
    <div class="panel">
      <div class="panel-title">${isPM?"Create Task":"Suggest Assignment"}</div>
      ${!isPM?`<div style="background:#faf5ff;border:1px solid #e9d5ff;border-radius:9px;padding:10px 12px;font-size:12px;color:var(--purple);margin-bottom:12px;">Your task will be submitted as a Suggested Assignment and needs PM approval.</div>`:""}
      <div class="form-grid">
        <div class="fg2 full"><label>Task Name *</label><input id="ctName" class="fi2" placeholder="Task name"></div>
        <div class="fg2"><label>Owner *</label><select id="ctOwner" class="fi2">${renderUserOpts(users,currentUser.id)}</select></div>
        <div class="fg2"><label>Priority</label>
          <select id="ctPriority" class="fi2">${PM_PRIORITIES.map(p=>`<option value="${esc(p)}"${p==="Medium"?" selected":""}>${esc(p)}</option>`).join("")}</select>
        </div>
        <div class="fg2"><label>Start Date *</label><input type="date" id="ctStart" class="fi2"></div>
        <div class="fg2"><label>Due Date *</label><input type="date" id="ctDue" class="fi2"></div>
        <div class="fg2"><label>Allocated Hours</label><input type="number" step="0.1" min="0" id="ctHours" class="fi2" placeholder="0"></div>
        <div class="fg2"><label>Weight %</label><input type="number" step="0.01" min="0" max="100" id="ctWeight" class="fi2" placeholder="0"></div>
      </div>
    </div>
    <div class="panel">
      <div class="panel-title">Collaborators</div>
      ${renderCollabPicker(users,[],"ct_collabs")}
    </div>`;

  const footer=`<button class="btn btn-ghost" data-close>Cancel</button><button class="btn ${isPM?"btn-primary":"btn-purple"}" id="ctSubmit">${isPM?"Create Task":"Submit Suggestion"}</button>`;
  const {el,close}=openModal(mShell(isPM?"Create Task":"Suggest Assignment","",body,footer),"modal-md");
  el.querySelector("#ctSubmit").addEventListener("click",async()=>{ await createTask(projectId,el.querySelector("#ctSubmit"),close,closeParent); });
}
window.openAddTaskModal=openAddTaskModal;

async function createTask(projectId,btn,closeModal,closeParent){
  const name    =document.getElementById("ctName")?.value?.trim();
  const ownerId =document.getElementById("ctOwner")?.value;
  const status  =isPM?"To Do":"Suggested";
  const priority=document.getElementById("ctPriority")?.value||"Medium";
  const start   =document.getElementById("ctStart")?.value;
  const due     =document.getElementById("ctDue")?.value;
  const hours   =Number(document.getElementById("ctHours")?.value||0);
  const weight  =Number(document.getElementById("ctWeight")?.value||0);
  const collabs =getChecked("ct_collabs");

  if(!name||!start||!due||!ownerId){ alert("Please fill Name, Owner, Start Date and Due Date."); return; }
  if(new Date(due)<new Date(start)){ alert("Due date cannot be before start date."); return; }

  btn.disabled=true; btn.textContent="Saving…";

  const {data:task,error}=await supabase.from("pm_tasks").insert({
    project_id:projectId,name,status,priority,
    owner_user_id:ownerId,created_by_user_id:currentUser.id,
    start_date:start,due_date:due,allocated_hours:hours,estimated_hours:hours,weight_percent:weight
  }).select("*").single();

  if(error||!task){ alert(error?.message||"Error creating task"); btn.disabled=false; btn.textContent=isPM?"Create Task":"Submit Suggestion"; return; }

  const cr=collabs.filter(id=>id&&id!==ownerId).map(id=>({task_id:task.id,user_id:id}));
  if(cr.length) await supabase.from("pm_task_collaborators").insert(cr);

  closeModal?.(); closeParent?.();
  await renderPage();
  await openProjectDetail(projectId);
}

