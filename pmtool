<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PM Tool · EvolveCX</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;}
:root{
  --bg:#f0f2f5;--surface:#fff;--border:#e2e8f0;--border-soft:#f1f5f9;
  --ink:#0f172a;--ink-2:#334155;--ink-3:#64748b;--ink-4:#94a3b8;
  --accent:#1a56db;--accent-bg:#eff6ff;--accent-border:#bfdbfe;
  --green:#16a34a;--green-bg:#dcfce7;
  --red:#dc2626;--red-bg:#fee2e2;
  --amber:#b45309;--amber-bg:#fef3c7;
  --purple:#7c3aed;--purple-bg:#ede9fe;
  --orange:#ea580c;--orange-bg:#fff7ed;
  --sidebar-bg:#0f172a;--sidebar-w:240px;--header-h:58px;
  --radius:14px;--shadow:0 4px 20px rgba(15,23,42,.08);--shadow-lg:0 20px 60px rgba(15,23,42,.2);
}
body{margin:0;font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--ink);min-height:100vh;}

/* LOGIN */
#loginView{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0f172a,#1e3a5f);}
.login-box{background:#fff;border-radius:20px;padding:40px 36px;width:380px;max-width:92vw;box-shadow:0 30px 80px rgba(0,0,0,.4);}
.login-logo{text-align:center;margin-bottom:28px;}
.login-logo .brand{font-size:26px;font-weight:900;color:var(--ink);}
.login-logo .sub{font-size:11px;color:var(--ink-3);margin-top:4px;font-weight:600;letter-spacing:1px;text-transform:uppercase;}
.lf{margin-bottom:12px;}
.lf label{display:block;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-3);margin-bottom:5px;}
.lf input{width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:14px;font-family:inherit;transition:border-color .15s;background:var(--bg);}
.lf input:focus{outline:none;border-color:var(--accent);background:#fff;}
.login-btn{width:100%;padding:13px;background:var(--ink);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:800;font-family:inherit;cursor:pointer;margin-top:6px;}
.login-btn:hover{background:#1e293b;}
.login-btn:disabled{opacity:.6;cursor:default;}
.login-err{color:var(--red);font-size:13px;text-align:center;margin-top:10px;}

/* APP */
#appView{display:none;min-height:100vh;}
.layout{display:flex;min-height:100vh;}

/* SIDEBAR */
.sidebar{width:var(--sidebar-w);background:var(--sidebar-bg);display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:100;}
.sb-logo{padding:22px 20px 16px;border-bottom:1px solid rgba(255,255,255,.07);}
.sb-logo .brand{font-size:18px;font-weight:900;color:#fff;}
.sb-logo .sub{font-size:11px;color:rgba(255,255,255,.35);margin-top:2px;}
.sb-user{padding:12px 20px;border-bottom:1px solid rgba(255,255,255,.07);}
.sb-user .name{font-size:13px;font-weight:700;color:#fff;}
.sb-user .role{font-size:11px;color:rgba(255,255,255,.4);margin-top:2px;}
.sb-nav{flex:1;padding:10px;}
.nav-lbl{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:rgba(255,255,255,.28);padding:10px 10px 5px;}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;color:rgba(255,255,255,.6);font-size:13px;font-weight:600;cursor:pointer;transition:all .12s;margin-bottom:2px;user-select:none;}
.nav-item:hover{background:rgba(255,255,255,.08);color:#fff;}
.nav-item.active{background:rgba(255,255,255,.13);color:#fff;}
.nav-item .icon{font-size:15px;width:20px;text-align:center;flex-shrink:0;}
.nav-badge{margin-left:auto;background:var(--red);color:#fff;font-size:10px;font-weight:800;padding:2px 6px;border-radius:99px;min-width:18px;text-align:center;}
.sb-footer{padding:14px 10px;border-top:1px solid rgba(255,255,255,.07);}
.logout-btn{display:flex;align-items:center;gap:8px;width:100%;padding:9px 12px;border-radius:9px;background:none;border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.5);font-size:12px;font-weight:700;font-family:inherit;cursor:pointer;transition:all .12s;}
.logout-btn:hover{background:rgba(255,255,255,.07);color:#fff;}

/* MAIN */
.main{margin-left:var(--sidebar-w);flex:1;display:flex;flex-direction:column;min-height:100vh;}
.topbar{height:var(--header-h);background:#fff;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:50;}
.topbar-title{font-size:15px;font-weight:800;}
.topbar-right{display:flex;align-items:center;gap:10px;}
.page{padding:24px;}

/* TABS */
.tabs{display:flex;gap:4px;margin-bottom:20px;border-bottom:2px solid var(--border);padding-bottom:0;}
.tab{padding:9px 18px;border-radius:9px 9px 0 0;border:none;background:none;font-family:inherit;font-size:13px;font-weight:700;color:var(--ink-3);cursor:pointer;transition:all .12s;position:relative;bottom:-2px;}
.tab:hover{background:var(--bg);color:var(--ink-2);}
.tab.active{background:#fff;color:var(--accent);border:2px solid var(--border);border-bottom:2px solid #fff;}
.tab .cnt{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:99px;font-size:10px;font-weight:800;background:var(--red);color:#fff;margin-left:6px;vertical-align:middle;}

/* KPI */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:20px;}
.kpi-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px;}
.kpi-label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-3);}
.kpi-value{font-size:30px;font-weight:900;color:var(--ink);margin-top:6px;line-height:1;}

/* FILTERS */
.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;align-items:flex-end;}
.fg{display:flex;flex-direction:column;gap:4px;}
.fg label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:var(--ink-3);}
.fi{padding:8px 12px;border:1.5px solid var(--border);border-radius:9px;font-size:13px;font-family:inherit;background:#fff;color:var(--ink);min-width:160px;transition:border-color .15s;}
.fi:focus{outline:none;border-color:var(--accent);}

/* PROJECT CARDS */
.projects-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;}
.pcard{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px;cursor:pointer;transition:all .15s;position:relative;overflow:hidden;}
.pcard:hover{border-color:#93c5fd;box-shadow:0 8px 24px rgba(15,23,42,.1);transform:translateY(-1px);}
.pcard::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.pcard.s-requested::before{background:var(--orange);}
.pcard.s-draft::before{background:var(--ink-4);}
.pcard.s-inprogress::before{background:var(--accent);}
.pcard.s-onhold::before{background:var(--amber);}
.pcard.s-completed::before{background:var(--green);}
.pcard.s-cancelled::before{background:var(--red);}
.pcard.s-underreview::before{background:var(--purple);}
.pcard-area{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;color:var(--ink-3);margin-bottom:5px;}
.pcard-name{font-size:17px;font-weight:800;color:var(--ink);line-height:1.2;margin-bottom:8px;}
.pcard-obj{font-size:12px;color:var(--ink-3);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:12px;}
.pcard-meta{display:flex;flex-direction:column;gap:4px;margin-bottom:12px;}
.pcard-row{display:flex;justify-content:space-between;font-size:12px;}
.pcard-row .lbl{color:var(--ink-3);}
.pcard-row .val{font-weight:700;color:var(--ink-2);}
.pcard-footer{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.progress-bg{height:6px;background:var(--bg);border-radius:99px;overflow:hidden;margin-bottom:4px;}
.progress-fill{height:100%;background:var(--accent);border-radius:99px;transition:width .3s;}
.progress-lbl{font-size:11px;font-weight:700;color:var(--ink-3);margin-bottom:10px;}

/* BADGES */
.badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:99px;font-size:11px;font-weight:800;}
.b-requested{background:var(--orange-bg);color:var(--orange);}
.b-draft{background:#f1f5f9;color:#64748b;}
.b-inprogress{background:var(--accent-bg);color:var(--accent);}
.b-onhold{background:var(--amber-bg);color:var(--amber);}
.b-completed{background:var(--green-bg);color:var(--green);}
.b-cancelled{background:var(--red-bg);color:var(--red);}
.b-underreview{background:var(--purple-bg);color:var(--purple);}
.b-suggested{background:var(--purple-bg);color:var(--purple);border:1px solid #e9d5ff;}
.b-todo{background:#f1f5f9;color:#64748b;}
.b-done{background:var(--green-bg);color:var(--green);}
.b-blocked{background:var(--red-bg);color:var(--red);}
.b-paused{background:var(--amber-bg);color:var(--amber);}
.b-c-open{background:#f1f5f9;color:#64748b;}
.b-c-before{background:var(--green-bg);color:var(--green);}
.b-c-on{background:var(--accent-bg);color:var(--accent);}
.b-c-after{background:var(--red-bg);color:var(--red);}
.b-c-overdue{background:var(--red-bg);color:var(--red);}
.b-low{background:var(--green-bg);color:var(--green);}
.b-medium{background:var(--amber-bg);color:var(--amber);}
.b-high{background:var(--red-bg);color:var(--red);}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:9px;border:1.5px solid transparent;font-size:13px;font-weight:700;font-family:inherit;cursor:pointer;transition:all .12s;text-decoration:none;white-space:nowrap;}
.btn-primary{background:var(--ink);color:#fff;border-color:var(--ink);}
.btn-primary:hover{background:#1e293b;}
.btn-ghost{background:#fff;color:var(--ink-2);border-color:var(--border);}
.btn-ghost:hover{background:var(--bg);border-color:#94a3b8;}
.btn-success{background:var(--green);color:#fff;border-color:var(--green);}
.btn-success:hover{background:#15803d;}
.btn-danger{background:var(--red);color:#fff;border-color:var(--red);}
.btn-danger:hover{background:#b91c1c;}
.btn-accent{background:var(--accent);color:#fff;border-color:var(--accent);}
.btn-accent:hover{background:#1d4ed8;}
.btn-orange{background:var(--orange);color:#fff;border-color:var(--orange);}
.btn-orange:hover{background:#c2410c;}
.btn-purple{background:var(--purple);color:#fff;border-color:var(--purple);}
.btn-purple:hover{background:#6d28d9;}
.btn-sm{padding:6px 11px;font-size:12px;border-radius:7px;}
.btn:disabled{opacity:.5;cursor:default;pointer-events:none;}

/* MODAL */
.modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.55);backdrop-filter:blur(4px);z-index:9000;display:flex;align-items:center;justify-content:center;padding:20px;}
.modal{background:#fff;border-radius:18px;width:min(980px,100%);max-height:min(90vh,960px);overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--shadow-lg);animation:modalIn .18s ease-out;}
.modal-sm{width:min(520px,100%);}
.modal-md{width:min(700px,100%);}
@keyframes modalIn{from{transform:scale(.97) translateY(8px);opacity:0;}to{transform:scale(1) translateY(0);opacity:1;}}
.modal-header{padding:18px 20px;display:flex;justify-content:space-between;align-items:flex-start;background:linear-gradient(180deg,#0f172a,#1e293b);color:#fff;flex-shrink:0;}
.mh-title{font-size:16px;font-weight:900;}
.mh-sub{font-size:12px;color:rgba(255,255,255,.55);margin-top:3px;}
.modal-close{background:rgba(255,255,255,.12);border:none;color:#fff;width:30px;height:30px;border-radius:99px;cursor:pointer;font-size:14px;display:grid;place-items:center;flex-shrink:0;transition:background .12s;}
.modal-close:hover{background:rgba(255,255,255,.22);}
.modal-body{flex:1;overflow-y:auto;padding:18px 20px;background:#f8fafc;}
.modal-footer{padding:14px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:10px;flex-shrink:0;background:#fff;}

/* PANEL */
.panel{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin-bottom:14px;}
.panel:last-child{margin-bottom:0;}
.panel-title{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-3);margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;}

/* FORM */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-grid-1{grid-template-columns:1fr;}
@media(max-width:520px){.form-grid{grid-template-columns:1fr;}}
.fg2{display:flex;flex-direction:column;gap:5px;}
.fg2.full{grid-column:1/-1;}
.fg2 label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:var(--ink-3);}
.fi2{padding:10px 12px;border:1.5px solid var(--border);border-radius:9px;font-size:13px;font-family:inherit;color:var(--ink);background:var(--bg);transition:border-color .15s,background .15s;width:100%;}
.fi2:focus{outline:none;border-color:var(--accent);background:#fff;}
.fi2[readonly]{background:#f1f5f9;color:var(--ink-3);cursor:default;}
textarea.fi2{resize:vertical;min-height:80px;}

/* KV */
.kv-grid{display:grid;gap:7px;}
.kv{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:var(--bg);border-radius:9px;gap:12px;font-size:13px;}
.kv-l{color:var(--ink-3);font-weight:700;font-size:12px;flex-shrink:0;}
.kv-v{font-weight:800;color:var(--ink);text-align:right;}

/* KANBAN */
.kanban-wrap{display:flex;gap:14px;overflow-x:auto;padding-bottom:8px;}
.kanban-wrap::-webkit-scrollbar{height:5px;}
.kanban-wrap::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px;}
.kanban-col{min-width:250px;max-width:250px;border-radius:var(--radius);border:1px solid var(--border);overflow:hidden;display:flex;flex-direction:column;}
.kanban-col-hdr{padding:11px 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);background:#fff;}
.kanban-col-title{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:800;color:var(--ink);}
.k-dot{width:9px;height:9px;border-radius:99px;flex-shrink:0;}
.k-cnt{font-size:11px;font-weight:800;padding:2px 8px;border-radius:99px;background:var(--bg);color:var(--ink-3);border:1px solid var(--border);}
.kanban-col-body{padding:10px;display:flex;flex-direction:column;gap:8px;flex:1;min-height:60px;}
.k-card{background:#fff;border:1px solid var(--border);border-radius:11px;padding:12px;}
.k-card-name{font-size:13px;font-weight:800;color:var(--ink);margin-bottom:8px;line-height:1.3;}
.k-card-meta{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--ink-3);}
.k-card-foot{margin-top:8px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}

/* SUGGESTED */
.suggested-section{border:2px dashed #e9d5ff;background:#faf5ff;border-radius:var(--radius);padding:14px;margin-bottom:14px;}
.sug-item{background:#fff;border:1px solid #e9d5ff;border-radius:11px;padding:12px;margin-bottom:8px;}
.sug-item:last-child{margin-bottom:0;}
.sug-item-name{font-size:13px;font-weight:800;color:var(--ink);margin-bottom:5px;}
.sug-item-meta{font-size:12px;color:var(--ink-3);margin-bottom:8px;display:flex;flex-direction:column;gap:2px;}
.sug-actions{display:flex;gap:6px;}

/* REQUIREMENTS FORM */
.req-section{background:#fffbeb;border:1px solid #fde68a;border-radius:var(--radius);padding:16px;margin-bottom:14px;}
.req-section-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:#92400e;margin-bottom:14px;display:flex;align-items:center;gap:6px;}
.req-block{background:#fff;border:1px solid #fde68a;border-radius:10px;padding:12px;margin-bottom:10px;}
.req-block:last-child{margin-bottom:0;}
.req-block-title{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.3px;color:#b45309;margin-bottom:10px;}

/* ALERTS / BANNERS */
.banner{border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px;}
.banner-green{background:linear-gradient(135deg,#14532d,#166534);color:#fff;}
.banner-blue{background:linear-gradient(135deg,#1d4ed8,#1e40af);color:#fff;}
.banner-orange{background:linear-gradient(135deg,#c2410c,#ea580c);color:#fff;}
.banner-red{background:linear-gradient(135deg,#991b1b,#dc2626);color:#fff;}
.banner-purple{background:linear-gradient(135deg,#5b21b6,#7c3aed);color:#fff;}
.banner-text{font-size:14px;font-weight:700;}
.banner-sub{font-size:12px;opacity:.75;margin-top:2px;}

/* ROW */
.row{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:10px 0;border-bottom:1px dashed var(--border);font-size:13px;}
.row:last-child{border-bottom:none;}
.row-left{display:flex;flex-direction:column;gap:3px;min-width:0;}
.row-main{font-weight:700;color:var(--ink);}
.row-sub{font-size:12px;color:var(--ink-3);}

/* COLLAB PICKER */
.collab-picker{display:grid;gap:6px;max-height:200px;overflow-y:auto;}
.collab-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1.5px solid var(--border);border-radius:9px;cursor:pointer;transition:border-color .12s;}
.collab-item:hover{border-color:var(--accent-border);}
.collab-item input[type="checkbox"]{accent-color:var(--accent);}
.collab-name{font-size:13px;font-weight:700;color:var(--ink);}
.collab-area{font-size:11px;color:var(--ink-3);}

/* CHIPS */
.chips{display:flex;flex-wrap:wrap;gap:6px;}
.chip{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:99px;font-size:11px;font-weight:700;background:var(--bg);border:1px solid var(--border);color:var(--ink-2);}

/* EMPTY */
.empty{padding:24px;text-align:center;color:var(--ink-3);font-size:13px;}
.empty-icon{font-size:28px;margin-bottom:8px;}
.empty-title{font-weight:800;color:var(--ink-2);margin-bottom:4px;}

/* REJECTION HISTORY */
.rejection-item{background:var(--red-bg);border:1px solid #fecaca;border-radius:10px;padding:12px;margin-bottom:8px;font-size:12px;}
.rejection-item .date{color:var(--red);font-weight:800;margin-bottom:4px;}
.rejection-item .note{color:#7f1d1d;line-height:1.4;}

/* REVIEW COUNT */
.review-pill{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:99px;font-size:11px;font-weight:800;}
.review-pill.r1{background:#fff7ed;color:var(--orange);border:1px solid #fed7aa;}
.review-pill.r2{background:var(--amber-bg);color:var(--amber);border:1px solid #fde68a;}
.review-pill.r3{background:var(--red-bg);color:var(--red);border:1px solid #fecaca;}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="loginView">
  <div class="login-box">
    <div class="login-logo">
      <div class="brand">📋 PM Tool</div>
      <div class="sub">EvolveCX · Project Management</div>
    </div>
    <div class="lf"><label>Corporate Email</label><input type="email" id="loginEmail" placeholder="you@evolvecx.com" autocomplete="email"></div>
    <div class="lf"><label>Password</label><input type="password" id="loginPassword" autocomplete="current-password"></div>
    <button class="login-btn" id="loginBtn">Sign in</button>
    <div class="login-err" id="loginErr"></div>
  </div>
</div>

<!-- APP -->
<div id="appView">
  <div class="layout">
    <aside class="sidebar">
      <div class="sb-logo"><div class="brand">📋 PM Tool</div><div class="sub">EvolveCX</div></div>
      <div class="sb-user" id="sbUser"></div>
      <nav class="sb-nav">
        <div class="nav-lbl">Navigation</div>
        <div class="nav-item active" id="navAll" onclick="setTab('all')">
          <span class="icon">🗂️</span> All Projects
          <span class="nav-badge" id="badgePending" style="display:none"></span>
        </div>
        <div class="nav-item" id="navMine" onclick="setTab('mine')">
          <span class="icon">👤</span> My Projects
        </div>
        <div class="nav-item" id="navReview" onclick="setTab('review')" id="navReview">
          <span class="icon">🔍</span> Under Review
          <span class="nav-badge" id="badgeReview" style="display:none"></span>
        </div>
      </nav>
      <div class="sb-footer">
        <button class="logout-btn" id="logoutBtn">↩ Sign out</button>
      </div>
    </aside>

    <div class="main">
