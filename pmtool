  const active   =projects.filter(p=>["Draft","In Progress","On Hold"].includes(p.status)).length;
  const completed=projects.filter(p=>p.status==="Completed").length;
  const overdue  =projects.filter(p=>p.status!=="Completed"&&isPast(p.due_date)).length;
  const review   =projects.filter(p=>p.status==="Requested"||p.status==="Under Review").length;

  if(kpiGrid) kpiGrid.innerHTML=`
    <div class="kpi-card"><div class="kpi-label">Total</div><div class="kpi-value">${projects.length}</div></div>
    <div class="kpi-card"><div class="kpi-label">Active</div><div class="kpi-value" style="color:var(--accent)">${active}</div></div>
