function openEditReqModal(project,closeParent){
  let req={};
  try{ req=(typeof project.requirements==="object"&&project.requirements!==null)?project.requirements:JSON.parse(project.requirements||"{}"); }catch(e){}

  const sections=[
    {num:1,title:"1. Información General",questions:["¿Nombre del proyecto?","¿Área solicitante?","¿Solicitante (nombre y rol)?"]},
    {num:2,title:"2. Objetivo del Proyecto",questions:["¿Qué se busca lograr?","¿Por qué es importante?","¿Qué problema resuelve?"]},
    {num:3,title:"3. Alcance",questions:["¿Qué incluye?","¿Qué no incluye?","¿Qué esperas recibir?","¿Qué sería una mala experiencia?","Si recortáramos tiempo, ¿qué es indispensable?"]},
    {num:4,title:"4. Requerimientos",questions:["Req 1 — ¿Qué problema tienes?","Req 1 — ¿Qué impacto tiene?","Req 2 — Cambios de estructura (si aplica)","Req 3 — Requerimientos técnicos"]},
    {num:5,title:"5. Stakeholders y Usuarios",questions:["Stakeholders clave","Usuarios finales","Áreas involucradas"]},
    {num:6,title:"6. Tiempos y Fechas Clave",questions:["Fecha ideal de inicio","Fecha objetivo de entrega","Fechas críticas / hitos","¿Quién necesita visibilidad del avance?"]},
    {num:7,title:"7. Prioridad",questions:["Tipo de prioridad (P0/P1/P2/P3)","¿Por qué se considera urgente?"]},
    {num:8,title:"8. Riesgos y Dependencias",questions:["Riesgos identificados","Dependencias","¿Qué podría retrasar el proyecto?","¿Dependemos de aprobaciones externas?"]},
    {num:9,title:"9. Bloqueos",questions:["¿Qué asumimos para avanzar?","¿Se necesita presupuesto aprobado?","¿Se cuenta con accesos o herramientas?"]},
    {num:10,title:"10. Métricas de Éxito (KPIs)",questions:["KPI 1","KPI 2","KPI 3","¿Qué indicadores deben mejorar?"]},
    {num:11,title:"11. Recursos Requeridos",questions:["Personas necesarias","Herramientas requeridas","Presupuesto (si aplica)"]}
  ];

  const body=sections.map(s=>`
    <div class="req-block">
      <div class="req-block-title">${esc(s.title)}</div>
      <div class="form-grid form-grid-1">
        ${s.questions.map((q,i)=>`
          <div class="fg2">
            <label>${esc(q)}</label>
            <textarea class="fi2" id="req_s${s.num}_q${i}" rows="2">${esc(req[`s${s.num}`]?.[`q${i}`]||"")}</textarea>
          </div>`).join("")}
      </div>
    </div>`).join("");

  const footer=`<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="reqSave">Save Requirements</button>`;
  const {el,close}=openModal(mShell("Requirements Template","Fill all sections before PM review",body,footer));

  el.querySelector("#reqSave").addEventListener("click",async()=>{
    const newReq={};
    sections.forEach(s=>{
      newReq[`s${s.num}`]={};
      s.questions.forEach((_,i)=>{
        const val=document.getElementById(`req_s${s.num}_q${i}`)?.value?.trim()||"";
        newReq[`s${s.num}`][`q${i}`]=val;
      });
    });

    const {error}=await supabase.from("pm_projects").update({requirements:newReq}).eq("id",project.id);
    if(error){ alert(error.message); return; }
    close();
    closeParent?.();
    await renderPage();
    await openProjectDetail(project.id);
  });
}
window.openEditReqModal=openEditReqModal;

/* ═══════════════════════════════════
   KANBAN COLUMN
═══════════════════════════════════ */
function renderKanbanCol(status,tasks,um){
  const filtered=tasks.filter(t=>t.status===status);
  const dot=dotColor(status);
  return `
    <div class="kanban-col" style="border-top:3px solid ${dot};">
      <div class="kanban-col-hdr">
        <div class="kanban-col-title"><span class="k-dot" style="background:${dot}"></span>${esc(status)}</div>
        <span class="k-cnt">${filtered.length}</span>
      </div>
      <div class="kanban-col-body">
        ${filtered.length?filtered.map(t=>{
          const owner=um[t.owner_user_id]?.full_name||"Unassigned";
          return `<div class="k-card">
            <div class="k-card-name">${esc(t.name||"Untitled")}</div>
            <div class="k-card-meta">
              <span><strong>Owner:</strong> ${esc(owner)}</span>
              <span><strong>Due:</strong> ${esc(t.due_date||"—")}</span>
              <span><strong>Hours:</strong> ${fmtNum(t.allocated_hours,1)}h · <strong>Weight:</strong> ${fmtNum(t.weight_percent,2)}%</span>
            </div>
            <div class="k-card-foot">${badgeCompliance(taskCompliance(t))}</div>
          </div>`;
        }).join(""):`<div class="empty" style="padding:12px 8px;">No tasks</div>`}
      </div>
    </div>`;
}

